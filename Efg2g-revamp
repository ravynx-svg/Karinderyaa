        if not SpinEnabled then
            return
        end

        local CurrentRoot = GetRoot()

        if CurrentRoot then
            CurrentRoot.AssemblyAngularVelocity =
                Vector3.new(0, SpinSpeed, 0)
        end
    end)
end

